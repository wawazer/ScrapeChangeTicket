{
  "name": "servicenow-pelindo-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable ServiceNow Pelindo scraper and patch release report generator",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "banner": "node scripts/banner.js",
    "postinstall": "node scripts/setup-hooks.js && node scripts/banner.js",
    "start": "node src/server.js",
    "check:memory": "node scripts/check-memory-sync.js",
    "dev": "node scripts/banner.js && node --watch src/server.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/visual/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:visual": "node --test tests/visual/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint src tests scripts --ext .js",
    "live:smoke": "node tests/live/smoke.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "node-machine-id": "^1.1.12",
    "pdfkit": "^0.16.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "pdfjs-dist": "^6.4.299"
  }
}

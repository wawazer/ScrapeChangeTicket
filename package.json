{
  "name": "servicenow-pelindo-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable ServiceNow Pelindo scraper and patch release report generator",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint src tests --ext .js",
    "live:smoke": "node tests/live/smoke.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.16.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0"
  }
}

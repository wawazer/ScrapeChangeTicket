SN_BASE_URL=
SN_USERNAME=
SN_PASSWORD=
HEADLESS=false
PORT=3000
SN_MAX_RETRIES=2
SN_PAGE_SIZE=100
SN_CHECKPOINT_EVERY=5
SN_CONCURRENCY=1
OUTPUT_DIR=output

# License server (device-bound license key check)
ZEVN_LICENSE_API_URL=https://zevn.web.id/api/license/verify

# AI Provider (groq | gemini | ollama | deepseek | openrouter)
AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# DeepSeek (free tier available)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (free tier models available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
